MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bongkar_label
APP_ORIGIN=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SESSION_SECURE=false
TRUST_PROXY=false
INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=
# Compose-only password; use URL-safe characters when overriding.
MONGO_ROOT_PASSWORD=local-development-only
APP_PORT=3000

# Optional OpenAI-compatible 9Router. Leave both router URL/key blank for direct Gemini.
NINE_ROUTER_BASE_URL=
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODEL=ag/gemini-3.8-flash-low

# Optional Linux filesystem socket; no published router TCP port.
NINE_ROUTER_SOCKET_PATH=
